# Vectryx Technologies Environment Configuration
# Copy this file to .env.local for local development.

# Resend API Key for sending lead inquiry emails
# Obtain from https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Verified recipient email address where website inquiries are forwarded
CONTACT_RECIPIENT_EMAIL=inquiries@vectryx.com

# Public site URL used for canonical URLs, sitemap, and Open Graph previews
NEXT_PUBLIC_SITE_URL=https://vectryx.com

# WhatsApp business phone number with country code (numbers only, e.g., 919876543210).
# If left empty, the floating WhatsApp contact trigger is safely hidden.
NEXT_PUBLIC_WHATSAPP_NUMBER=
WHATSAPP_NUMBER=
